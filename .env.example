# Epileptic application component configuration.
# Copy to .env and adjust for the local environment.

# HTTP address the Communication Service listens on.
EPILEPTIC_HTTP_ADDR=:8080

# Postgres connection string for the Content data store.
EPILEPTIC_DATABASE_URL=postgres://epileptic:epileptic@localhost:5432/epileptic?sslmode=disable

# Gin run mode: debug | release | test
EPILEPTIC_ENV=debug
